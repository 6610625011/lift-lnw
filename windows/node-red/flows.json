[
  {
    "id": "mockup",
    "type": "tab",
    "label": "ESP32 Elevator A–D",
    "disabled": false,
    "info": "ESP32 authoritative four-car mockup. Windows Mosquitto + Node-RED."
  },
  {
    "id": "mqtt-local",
    "type": "mqtt-broker",
    "name": "Windows Mosquitto",
    "broker": "127.0.0.1",
    "port": "1883",
    "clientid": "node-red-elevator",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "15",
    "cleansession": true,
    "autoUnsubscribe": true
  },
  {
    "id": "state-in",
    "type": "mqtt in",
    "z": "mockup",
    "name": "ESP32 state + events",
    "topic": "elevator/v1/mockup/+",
    "qos": "1",
    "datatype": "utf8",
    "broker": "mqtt-local",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 160,
    "y": 100,
    "wires": [
      [
        "monitor",
        "wirelog"
      ]
    ]
  },
  {
    "id": "broker-status",
    "type": "status",
    "z": "mockup",
    "name": "Broker connection",
    "scope": [
      "state-in"
    ],
    "x": 160,
    "y": 160,
    "wires": [
      [
        "broker-topic"
      ]
    ]
  },
  {
    "id": "broker-topic",
    "type": "change",
    "z": "mockup",
    "name": "Broker status topic",
    "rules": [
      {
        "t": "set",
        "p": "topic",
        "pt": "msg",
        "to": "broker-status",
        "tot": "str"
      }
    ],
    "x": 390,
    "y": 160,
    "wires": [
      [
        "monitor"
      ]
    ]
  },
  {
    "id": "heartbeat",
    "type": "inject",
    "z": "mockup",
    "name": "Check stale data each second",
    "props": [
      {
        "p": "topic",
        "vt": "str"
      },
      {
        "p": "payload"
      }
    ],
    "topic": "tick",
    "payload": "",
    "payloadType": "date",
    "repeat": "1",
    "once": true,
    "onceDelay": 0.5,
    "x": 200,
    "y": 220,
    "wires": [
      [
        "monitor",
        "wirelog"
      ]
    ]
  },
  {
    "id": "monitor",
    "type": "function",
    "z": "mockup",
    "name": "Validate state / detect offline / events",
    "func": "// Executed inside a Node-RED function node. Only fresh ESP32 state proves liveness.\r\nlet model = flow.get('model') || {state:null, receivedAt:0, liveAt:0, availability:'offline', broker:false, events:[], feedback:'', pending:null};\r\nconst now = Date.now();\r\nif (msg.topic === 'broker-status') {\r\n    model.broker = msg.status?.text === 'node-red:common.status.connected' || msg.status?.text === 'connected';\r\n}\r\nif (msg.topic === 'elevator/v1/mockup/state') {\r\n    let state;\r\n    try { state = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload; } catch { return null; }\r\n    const phases = ['idle','coming','boarding','riding','arrived'];\r\n    if (!state || !phases.includes(state.phase) || !/^[0-9a-f]{16}$/.test(state.boot_id) || !Number.isInteger(state.uptime_ms) || state.uptime_ms < 0 || state.uptime_ms > 4294967295 || !['-','A','B','C','D'].includes(state.assigned) || !state.floors || !['A','B','C','D'].every(id => Number.isInteger(state.floors[id]) && state.floors[id]>=1 && state.floors[id]<=20) || !Number.isInteger(state.hall_floor) || state.hall_floor<1 || state.hall_floor>20 || !Number.isInteger(state.destination) || state.destination<0 || state.destination>20 || (state.targets!==undefined && !(state.targets && ['A','B','C','D'].every(id=>Number.isInteger(state.targets[id]) && state.targets[id]>=0 && state.targets[id]<=20))) || !Array.isArray(state.lcd) || state.lcd.length!==2 || !state.lcd.every(row=>typeof row==='string' && row.length<=16)) return null;\r\n    if (model.state && model.state.boot_id !== state.boot_id) model.pending=null;\r\n    model.state=state; model.receivedAt=now;\r\n    if (!msg.retain) { model.liveAt=now; model.availability='online'; model.broker=true; }\r\n}\r\nif (msg.topic === 'elevator/v1/mockup/availability') {\r\n    if (['online','offline'].includes(msg.payload)) model.availability=msg.payload;\r\n    if (msg.payload==='offline') model.liveAt=0;\r\n}\r\nif (msg.topic === 'elevator/v1/mockup/events' && !msg.retain) {\r\n    let event;\r\n    try { event=typeof msg.payload==='string'?JSON.parse(msg.payload):msg.payload; } catch {return null;}\r\n    const hall=model.state?.hall_floor||1, dest=model.state?.destination||0;\r\n    const labels={assigned:'มอบหมายลิฟต์แล้ว · ให้ไปที่ลิฟต์ที่ได้รับมอบหมาย',pickup:'ลิฟต์ถึงชั้น '+hall+' แล้ว รอเลือกชั้น',selected:'เลือกชั้นปลายทางแล้ว',riding:'กำลังไปชั้น '+(dest||'ปลายทาง'),arrival:'ถึงชั้น '+(dest||'ปลายทาง')+' แล้ว',ready:'พร้อมรับคำขอใหม่',accepted:'บอร์ดรับคำสั่งจากแดชบอร์ดแล้ว',busy:'บอร์ดปฏิเสธคำสั่ง (ลิฟต์ไม่อยู่ในสถานะที่รับได้)',expired:'คำขอหมดอายุ กรุณากดใหม่'};\r\n    if (!event || event.boot_id!==model.state?.boot_id || !labels[event.type]) return null;\r\n    model.events.unshift({time:now,text:labels[event.type]+(event.source==='button'?' (ปุ่มที่บอร์ด)':'')});\r\n    model.events=model.events.slice(0,30);\r\n    if (model.pending?.id===event.request_id && ['accepted','busy','expired'].includes(event.type)) {model.feedback=labels[event.type]; model.pending=null;}\r\n}\r\nmodel.online=Boolean(model.state && model.broker && model.availability==='online' && now-model.liveAt<3500);\r\nif (model.pending && now-model.pending.time>6000) {model.pending=null;model.feedback='ยังไม่ได้รับคำตอบจากบอร์ด กรุณาตรวจสอบการเชื่อมต่อ';}\r\nflow.set('model',model);\r\nreturn {payload:model};\r\n",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 650,
    "y": 100,
    "wires": [
      [
        "dashboard"
      ]
    ]
  },
  {
    "id": "dashboard",
    "type": "ui-template",
    "z": "mockup",
    "group": "lift-group",
    "page": "",
    "ui": "",
    "name": "Four elevators",
    "order": 1,
    "width": 12,
    "height": 0,
    "format": "<template>\r\n  <div class=\"elevator-app\">\r\n    <div class=\"lift-heading\"><div><div class=\"eyebrow\">ESP32 · MQTT · NODE-RED</div><h1>ระบบลิฟต์จำลอง</h1><p>ลิฟต์ 4 ตัว · อาคาร 20 ชั้น</p></div><a class=\"navlink\" href=\"/dashboard/dataflow\">ดูการส่งข้อมูลของระบบ →</a><span class=\"connection\" :class=\"{live: view.online}\">{{ view.online ? (view.state?.emulator ? '● เชื่อมต่อแล้ว (ตัวจำลอง ESP32)' : '● เชื่อมต่อ ESP32 แล้ว') : '○ รอการเชื่อมต่อ ESP32' }}</span></div>\r\n    <div class=\"journey\"><div><small>จุดเรียก</small><strong>ชั้น {{ hall }}</strong></div><span>→</span><div><small>ปลายทาง</small><strong>{{ dest ? 'ชั้น '+dest : 'เลือกในลิฟต์' }}</strong></div><div class=\"assignment\"><small>ลิฟต์ที่ได้รับมอบหมาย</small><strong>{{ view.state?.assigned !== '-' ? (view.state?.assigned || '—') : '—' }}</strong></div><label class=\"here\"><small>ตอนนี้คุณอยู่ชั้น</small><select v-model.number=\"myFloor\" :disabled=\"!canRequest\"><option v-for=\"f in padFloors\" :key=\"f\" :value=\"f\">ชั้น {{ f }}</option></select></label><button :disabled=\"!canRequest\" @click=\"send({topic:'verify',payload:myFloor})\">เรียกลิฟต์ (ชั้น {{ myFloor }})</button></div>\r\n    <div class=\"offline-note\" v-if=\"!view.online\">{{ view.state ? 'ขาดการเชื่อมต่อ — แสดงข้อมูลล่าสุดที่ได้รับ' : 'ยังไม่มีข้อมูลจากบอร์ด กรุณาเปิด ESP32 และเชื่อมต่อ Wi-Fi' }}</div>\r\n    <section class=\"building\">\r\n      <div class=\"trip-banner\" :class=\"tripClass\">{{ tripText }}</div>\r\n      <div class=\"bldg-grid\">\r\n        <div class=\"floor-col\"><div class=\"bhead\"></div><div v-for=\"f in floorList\" :key=\"f\" class=\"flabel\" :class=\"{hall:f===hall,dest:f===dest}\">{{ f }}<em v-if=\"f===hall\">จุดเรียก</em><em v-else-if=\"f===dest\">ปลายทาง</em></div></div>\r\n        <div v-for=\"id in ids\" :key=\"id\" class=\"bshaft\" :class=\"{assigned: assigned===id}\">\r\n          <div class=\"bhead\">ลิฟต์ {{ id }}</div>\r\n          <div class=\"bbody\">\r\n            <div v-for=\"f in floorList\" :key=\"f\" class=\"rowline\" :class=\"{hall:f===hall,dest:f===dest}\"></div>\r\n            <div v-if=\"trail(id)\" class=\"trail\" :style=\"trail(id)\"></div>\r\n            <div class=\"bcar\" :class=\"carClass(id)\" :style=\"{bottom:(floorOf(id)-1)*24+2+'px'}\"><span class=\"cid\">{{ id }}</span><span class=\"cfl\">{{ floorOf(id) }}</span><span class=\"carrow\">{{ arrow(id) }}</span></div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </section>\r\n    <section class=\"floorpad\" :class=\"{disabled:!canSelect}\">\r\n      <h2>แผงปุ่มในลิฟต์ {{ assigned || '' }} <small>{{ canSelect ? 'กดเลือกชั้นที่ต้องการไป' : (dest ? 'เลือกชั้น '+dest+' แล้ว' : 'ปุ่มจะใช้ได้เมื่อลิฟต์มาถึงและเปิดประตู') }}</small></h2>\r\n      <div class=\"pad\"><button v-for=\"f in padFloors\" :key=\"f\" :class=\"{chosen:f===dest}\" :disabled=\"!canSelect || f===floorOf(assigned)\" @click=\"send({topic:'select',payload:f})\">{{ f }}</button></div>\r\n    </section>\r\n    <div class=\"lift-cards\">\r\n      <article v-for=\"id in ['A','B','C','D']\" :key=\"id\" :class=\"['lift-card',{assigned: view.state?.assigned === id, stale:!view.online}]\">\r\n        <header><b>ลิฟต์ {{ id }}</b><span>{{ status(id) }}</span></header>\r\n        <div class=\"floor\"><strong>{{ view.state?.floors?.[id] ?? '—' }}</strong><span>ชั้นปัจจุบัน</span></div>\r\n        <div class=\"shaft\"><div class=\"car\" :style=\"{bottom: (((view.state?.floors?.[id] || 1)-1)/19*83)+'%'}\">{{ id }}</div><div class=\"shaft-label top\">20</div><div class=\"shaft-label bottom\">1</div></div>\r\n        <footer>{{ view.state?.assigned === id ? (ambientBusy ? 'ถูกเลือก (ถึงเร็วที่สุด)' : phaseLabel) : (etaText(id) || 'พร้อมรับงาน') }}<span v-if=\"etaText(id) && view.state?.assigned === id\"> · {{ etaText(id) }}</span></footer>\r\n      </article>\r\n    </div>\r\n    <div class=\"details\"><section><h2>หน้าจอที่บอร์ด</h2><div class=\"lcd\"><div>{{ view.state?.lcd?.[0] || 'WAITING FOR DATA' }}</div><div>{{ view.state?.lcd?.[1] || '                ' }}</div></div><p class=\"feedback\">{{ view.feedback || 'กดปุ่มบนบอร์ดหรือปุ่มเรียกลิฟต์ด้านบนเพื่อเริ่ม' }}</p><small>อัปเดตล่าสุด: {{ view.receivedAt ? new Date(view.receivedAt).toLocaleTimeString('th-TH') : '—' }}</small></section><section><h2>เหตุการณ์ล่าสุด</h2><div class=\"events\"><div v-for=\"(event,index) in (view.events || [])\" :key=\"index\"><time>{{ new Date(event.time).toLocaleTimeString('th-TH') }}</time><span>{{ event.text }}</span></div><p v-if=\"!view.events?.length\">รอเหตุการณ์จาก ESP32</p></div></section></div>\r\n    <p class=\"mockup-note\">แบบจำลอง: เลือกชั้นที่ยืนอยู่ แล้วเรียกลิฟต์ · เลือกชั้นปลายทางในลิฟต์ · 2 วินาทีต่อชั้น · รอเลือกชั้นสูงสุด 30 วินาที</p>\r\n  </div>\r\n</template>\r\n<script>\r\nexport default {\r\n  data() { return { myFloor: 1 }; },\r\n  computed: {\r\n    view() { return this.msg?.payload || {}; },\r\n    busyOthers() { return this.ids.some(id => (this.view.state?.targets?.[id]||0)>0); },\r\n    ids() { return ['A','B','C','D']; },\r\n    floorList() { return Array.from({length:20},(_,i)=>20-i); },\r\n    hall() { return this.phase==='idle' ? this.myFloor : (this.view.state?.hall_floor || 1); },\r\n    dest() { return this.view.state?.destination || 0; },\r\n    canSelect() { return this.view.online && this.phase==='boarding' && !this.dest && !this.view.pending; },\r\n    padFloors() { return Array.from({length:20},(_,i)=>i+1); },\r\n    assigned() { const a=this.view.state?.assigned; return a && a!=='-' ? a : null; },\r\n    phase() { return this.view.state?.phase || 'idle'; },\r\n    target() { return this.phase==='coming' ? this.hall : this.phase==='riding' ? this.dest : null; },\r\n    ambientBusy() { return !!this.assigned && this.phase==='coming' && (this.view.state?.targets?.[this.assigned]||0)>0; },\r\n    moving() { return this.view.online && this.assigned && this.target!==null && !this.ambientBusy; },\r\n    direction() { if(!this.moving) return 0; return Math.sign(this.target-this.floorOf(this.assigned)); },\r\n    remaining() { return this.moving ? Math.abs(this.target-this.floorOf(this.assigned)) : 0; },\r\n    tripClass() { return !this.view.online ? 'off' : this.phase; },\r\n    tripText() {\r\n      if(!this.view.online) return 'รอข้อมูลสดจาก ESP32';\r\n      const a=this.assigned, f=a?this.floorOf(a):0, n=this.remaining;\r\n      if(this.ambientBusy) return 'ไปที่ลิฟต์ '+a+' · ลิฟต์ส่งผู้โดยสารอื่นถึงชั้น '+this.view.state.targets[a]+' ก่อน แล้วจะมารับคุณที่ชั้น '+this.hall+' (ประเมิน ~'+(this.view.state?.eta_s?.[a]??'?')+' วินาที)';\r\n      if(this.phase==='coming') return 'ไปที่ลิฟต์ '+a+' · กำลัง'+(this.direction<0?'ลงมา':'ขึ้นไป')+'รับที่ชั้น '+this.hall+' · ตอนนี้ชั้น '+f+' · อีก '+n+' ชั้น (~'+n*2+' วินาที)';\r\n      if(this.phase==='boarding') return this.dest ? 'เลือกชั้น '+this.dest+' แล้ว · ประตูกำลังปิด' : 'ลิฟต์ '+a+' เปิดประตูแล้ว · เข้าไปแล้วกดเลือกชั้นที่ต้องการ';\r\n      if(this.phase==='riding') return 'ลิฟต์ '+a+' กำลังพา'+(this.direction<0?'ลง':'ขึ้น')+'ไปชั้น '+this.dest+' · ตอนนี้ชั้น '+f+' · อีก '+n+' ชั้น (~'+n*2+' วินาที)';\r\n      if(this.phase==='arrived') return 'ลิฟต์ '+a+' ถึงชั้น '+this.dest+' แล้ว';\r\n      return this.busyOthers ? 'ลิฟต์บางตัวกำลังพาผู้โดยสารอื่นอยู่ · เลือกชั้นที่ยืน แล้วกดเรียกลิฟต์ ระบบจะคำนวณว่าตัวไหนถึงเร็วที่สุด' : 'ลิฟต์ทุกตัวว่าง · เลือกชั้นที่ยืน แล้วกดเรียกลิฟต์';\r\n    },\r\n    canRequest() { return this.view.online && ['idle','arrived'].includes(this.view.state?.phase) && !this.view.pending; },\r\n    phaseLabel() { return {idle:'พร้อมรับงาน',coming:'กำลังมารับ',boarding:'ถึงจุดรับ / รอเลือกชั้น',riding:'กำลังไปชั้นปลายทาง',arrived:'ถึงปลายทางแล้ว'}[this.view.state?.phase] || 'รอข้อมูล'; }\r\n  },\r\n  methods: {\r\n    floorOf(id) { return this.view.state?.floors?.[id] ?? 1; },\r\n    otherTarget(id) { const t=this.view.state?.targets?.[id]||0; return t && t!==this.floorOf(id) ? t : 0; },\r\n    arrow(id) { if(id===this.assigned && this.moving) return this.direction>0?'▲':'▼'; const t=this.otherTarget(id); return t ? (t>this.floorOf(id)?'▲':'▼') : ''; },\r\n    carClass(id) { const mine=id===this.assigned && this.moving; return {assigned:id===this.assigned, moving:mine, ambient:!mine && !!this.otherTarget(id), stale:!this.view.online, 'has-state':!!this.view.state}; },\r\n    trail(id) {\r\n      if(id!==this.assigned || !this.moving) return null;\r\n      const f=this.floorOf(id), t=this.target;\r\n      return {bottom:(Math.min(f,t)-1)*24+14+'px', height:Math.abs(t-f)*24+'px'};\r\n    },\r\n    status(id) { if(!this.view.online) return 'ข้อมูลไม่สด'; if(this.view.state?.assigned === id) return this.ambientBusy ? 'ส่งผู้โดยสารอื่นก่อน' : this.phaseLabel; const t=this.view.state?.targets?.[id]||0; return t ? (this.otherTarget(id) ? 'พาผู้โดยสารไปชั้น '+t : 'ผู้โดยสารกำลังลง') : 'ว่าง'; },\r\n    etaText(id) { const e=this.view.state?.eta_s?.[id]; return e===undefined ? '' : 'ประเมินถึงคุณ ~'+e+' วินาที'; }\r\n  }\r\n}\r\n</script>\r\n<style>\r\n.elevator-app{max-width:1240px;margin:auto;padding:12px 6px 22px;color:#172a3a;font-family:Tahoma,'Segoe UI',sans-serif}.lift-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:8px 0 26px}.eyebrow{font-size:11px;font-weight:700;letter-spacing:2px;color:#526b7b}h1{font-size:30px;margin:8px 0 3px}.lift-heading p{color:#607482;margin:0}.connection{background:#edf0f2;padding:10px 14px;border-radius:24px;color:#687782;font-size:13px;white-space:nowrap}.connection.live{background:#e4f5ec;color:#18764e}.journey{display:flex;gap:28px;align-items:center;padding:22px 26px;background:#fff;border:1px solid #dce5eb;border-radius:14px;margin-bottom:22px}.journey small{display:block;color:#647786;font-size:12px;margin-bottom:4px}.journey strong{font-size:23px}.assignment{margin-left:auto}.journey button{background:#126c82;color:white;padding:14px 20px;border-radius:9px;font-weight:700;cursor:pointer}.journey button:disabled{background:#d7e1e6;color:#7b8e9a;cursor:default}.lift-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.lift-card{position:relative;border:1px solid #dce5eb;background:white;border-radius:14px;padding:19px;overflow:hidden}.lift-card.assigned{border:2px solid #12819a;background:#f1fbfd;padding:18px}.lift-card.stale{opacity:.65}.lift-card header{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}.lift-card header b{font-size:20px;white-space:nowrap}.lift-card header span{font-size:11px;color:#587080;text-align:right}.floor{padding:20px 0 12px;display:flex;flex-direction:column}.floor strong{font-size:60px;font-weight:700;line-height:1.1}.floor span{color:#708591;font-size:12px}.shaft{position:absolute;right:22px;top:80px;height:105px;width:45px;background:#eef3f6;border-radius:5px}.car{position:absolute;bottom:0;background:#126c82;color:#fff;border-radius:4px;width:26px;height:19px;text-align:center;font-size:12px;transition:bottom 1s ease}.shaft-label{position:absolute;right:-12px;color:#8195a1;font-size:9px}.shaft-label.top{top:0}.shaft-label.bottom{bottom:0}.lift-card footer{margin-top:19px;border-top:1px solid #dce5eb;padding-top:12px;font-size:12px;color:#587080}.details{display:grid;grid-template-columns:1fr 1.3fr;gap:20px;margin-top:22px}.details section{padding:22px;background:white;border:1px solid #dce5eb;border-radius:14px}.details h2{font-size:16px;margin:0 0 16px}.lcd{font-family:Consolas,monospace;font-size:22px;line-height:1.5;letter-spacing:2px;background:#c5e68e;color:#243a17;width:fit-content;padding:12px 20px;border:5px solid #243b43;border-radius:6px;white-space:pre}.feedback{font-size:13px;margin:16px 0 8px}.details small{font-size:11px;color:#708591}.events{max-height:190px;overflow-y:auto}.events>div{display:flex;gap:14px;padding:7px 0;border-bottom:1px solid #eef2f4;font-size:12px}.events time{color:#78909c;white-space:nowrap}.mockup-note{font-size:11px;color:#78909c;text-align:center;margin:20px 0 0}.offline-note{background:#fff0d4;border-radius:8px;padding:10px 16px;margin-bottom:16px;color:#875c14;font-size:13px}@media(max-width:850px){.lift-cards{grid-template-columns:repeat(2,1fr)}.journey{flex-wrap:wrap;gap:20px}.assignment{margin-left:0}.details{grid-template-columns:1fr}.lift-heading{align-items:flex-start;flex-direction:column}}@media(max-width:430px){.lift-cards{gap:8px}.lift-card{padding:13px}.lift-card.assigned{padding:12px}.lift-card header{flex-direction:column}.shaft{right:18px;top:100px;height:85px}.floor strong{font-size:50px}.lcd{font-size:16px;letter-spacing:1px;padding:10px}.journey{padding:18px}.journey button{width:100%}}\r\n.building{background:#fff;border:1px solid #dce5eb;border-radius:14px;padding:18px 22px 22px;margin-bottom:22px}.trip-banner{padding:12px 16px;border-radius:9px;background:#edf0f2;color:#4d6270;font-size:15px;font-weight:700;margin-bottom:16px}.trip-banner.coming{background:#fff3d6;color:#8a5a00}.trip-banner.boarding{background:#e0f2fe;color:#075985}.trip-banner.riding{background:#e0f5ee;color:#0f6b4b}.trip-banner.arrived{background:#e4f5ec;color:#18764e}.trip-banner.off{background:#fff0d4;color:#875c14}.bldg-grid{display:grid;grid-template-columns:78px repeat(4,1fr);gap:10px}.bhead{height:28px;line-height:28px;text-align:center;font-weight:700;font-size:14px;color:#3b5565}.bshaft.assigned .bhead{color:#0f6b82}.floor-col .flabel{height:24px;line-height:24px;text-align:right;font-size:11px;color:#8195a1;padding-right:6px;white-space:nowrap}.flabel em{font-style:normal;margin-left:5px;font-size:10px;font-weight:700;color:#fff;background:#d97706;border-radius:8px;padding:1px 6px}.flabel.dest em{background:#12819a}.flabel.hall,.flabel.dest{font-weight:700;color:#172a3a}.bbody{position:relative;background:#f1f5f7;border-radius:8px;overflow:hidden}.bshaft.assigned .bbody{background:#e8f6f9;box-shadow:inset 0 0 0 2px #12819a}.rowline{height:24px;border-bottom:1px solid #e0e8ec;box-sizing:border-box}.rowline.hall{background:rgba(217,119,6,.14)}.rowline.dest{background:rgba(18,129,154,.14)}.trail{position:absolute;left:50%;width:0;border-left:3px dotted #12819a;transform:translateX(-50%);opacity:.7;transition:bottom var(--step,2s) linear,height var(--step,2s) linear}.bcar{position:absolute;left:50%;margin-left:-30px;width:60px;height:20px;border-radius:5px;background:#7f98a6;color:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 6px;box-sizing:border-box;font-size:12px;font-weight:700;transition:bottom var(--step,2s) linear;box-shadow:0 1px 3px rgba(0,0,0,.25)}.bcar.assigned{background:#126c82;box-shadow:0 0 0 2px #fff,0 0 0 4px #12819a;z-index:2}.bcar.moving{background:#d97706;box-shadow:0 0 0 2px #fff,0 0 0 4px #f59e0b;animation:liftpulse 1s ease-in-out infinite}.bcar.stale{opacity:.5}.bcar .cfl{font-weight:400;opacity:.9}.bcar .carrow{position:absolute;right:-22px;font-size:15px;color:#d97706}@keyframes liftpulse{50%{filter:brightness(1.18)}}@media(max-width:600px){.bldg-grid{grid-template-columns:52px repeat(4,1fr);gap:5px}.flabel em{display:none}.bcar{width:44px;margin-left:-22px;padding:0 3px;font-size:10px}.bcar .carrow{right:-14px;font-size:12px}.building{padding:12px}}\r\n.floorpad{background:#fff;border:1px solid #dce5eb;border-radius:14px;padding:16px 22px 20px;margin-bottom:22px}.floorpad h2{font-size:16px;margin:0 0 12px}.floorpad h2 small{font-weight:400;color:#647786;margin-left:8px;font-size:12px}.pad{display:grid;grid-template-columns:repeat(10,1fr);gap:8px}.pad button{padding:12px 0;border-radius:8px;border:1px solid #b8ccd6;background:#fff;font-weight:700;font-size:15px;cursor:pointer;color:#126c82}.pad button:hover:not(:disabled){background:#e8f6f9}.pad button:disabled{background:#eef2f4;color:#a2b2bc;border-color:#e0e8ec;cursor:default}.pad button.chosen{background:#126c82;color:#fff;border-color:#126c82}@media(max-width:600px){.pad{grid-template-columns:repeat(5,1fr)}}\r\n.here{display:flex;flex-direction:column}.here select{font:inherit;font-size:16px;font-weight:700;padding:9px 10px;border-radius:8px;border:1px solid #b8ccd6;background:#fff;color:#126c82}.here select:disabled{background:#eef2f4;color:#8195a1}\r\n.bcar.ambient{background:#4f86a8;box-shadow:0 1px 3px rgba(0,0,0,.25)}.bcar.ambient .carrow{color:#4f86a8}.navlink{font-size:12px;color:#126c82;text-decoration:none;white-space:nowrap;margin-left:auto;margin-right:12px}.navlink:hover{text-decoration:underline}\r\n</style>\r\n",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
